# Bot
PORT=3000
RESTAURANT_NAME="La Curva del Paraíso"
RESTAURANT_ID=la-curva-del-paraiso
DELIVERY_FEE=8
RESTAURANT_ADMIN_PHONE=933240664
RESTAURANT_ADMIN_CHAT_IDS=51933240664@c.us
RESTAURANT_SCHEDULE="Mar–Dom 11:00 – 17:00 (cerrado lunes)"
RESTAURANT_DELIVERY_ZONE="Surco, Miraflores y alrededores"
RESTAURANT_CURRENCY=PEN

# Firebase (ruta al JSON de service account descargado de Firebase Console)
FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json
FIREBASE_PROJECT_ID=chatbot-restaurante-40e94

# OpenWA
OPENWA_URL=http://localhost:2785
OPENWA_API_KEY=
OPENWA_SESSION_NAME=restaurante
OPENWA_SESSION_ID=

# Sesión — expiración por inactividad durante un pedido
SESSION_WARNING_MINUTES=25
# Webhook (debe coincidir con el secret registrado en OpenWA)
WEBHOOK_SECRET=cambia-este-secreto

# OpenWA rechaza "localhost" en webhooks — usar 127.0.0.1
OPENWA_WEBHOOK_URL=http://127.0.0.1:3000/webhook
