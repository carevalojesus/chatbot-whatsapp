# Bot
PORT=3000
RESTAURANT_NAME=La Buena Mesa
DELIVERY_FEE=5000

# OpenWA
OPENWA_URL=http://localhost:2785
OPENWA_API_KEY=
OPENWA_SESSION_NAME=restaurante

# Webhook (debe coincidir con el secret registrado en OpenWA)
WEBHOOK_SECRET=cambia-este-secreto

# URL que OpenWA usa para enviar eventos al bot
# - Bot en local + OpenWA en Docker: http://host.docker.internal:3000/webhook
# - Ambos en Docker (misma red): http://bot:3000/webhook
OPENWA_WEBHOOK_URL=http://host.docker.internal:3000/webhook
